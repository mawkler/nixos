font-family = FiraCode Nerd Font
font-family-bold = Fira Code Bold
font-family-italic = Liberation Mono Italic
font-family-bold-italic = Liberation Mono Bold Italic
font-size = 11

command = "bash ~/.config/ghostty/herdr-attach.sh"

background-opacity = 0.85
# Since 1.4 Ghostty tells the compositor whether to blur it, and Hyprland
# obeys: without this it asks for no blur at all.
background-blur = true
window-decoration = none
theme = onedark
title = Ghostty

keybind = ctrl+)=reset_font_size
keybind = ctrl+enter=ignore

custom-shader = shaders/cursor_warp.glsl
